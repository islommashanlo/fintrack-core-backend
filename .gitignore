# Bundler and local environment
/.bundle
/.env*
!/.env.example

# Logs and temp files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Raw filing archive (local adapter) and other local storage
/storage/*
!/storage/.keep

/public/assets
/config/master.key
/spec/examples.txt
/coverage
