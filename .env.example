# Copy to .env (make setup does this) and fill in. .env is not committed.

# Contact address sent to the SEC in every request's User-Agent. Required.
SEC_USER_AGENT_EMAIL=you@example.com

# Set to "on" to let Sidekiq poll EDGAR every minute. Leave off in development
# unless you mean to send live requests to the SEC.
EDGAR_POLLING=off

# Configure these before delivering real email; local specs use the test adapter.
APP_HOST=example.com
MAIL_FROM=from@example.com

# Credentials for /sidekiq and /ops/metrics (HTTP basic). While either is empty, both endpoints refuse everyone.
OPS_USERNAME=
OPS_PASSWORD=

# Exact React frontend origin for credentialed API requests; blank means same-origin only.
# Use the same site for frontend and API (for example app.example.com and api.example.com).
FRONTEND_ORIGIN=

# Provider keys with approved public price redistribution rights; comma-separated.
# Blank keeps raw prices unavailable. This never enables fetching or a provider.
MARKET_DATA_PUBLIC_PROVIDERS=

# News provider keys with approved headline/link publication terms; blank disables feeds.
# This permits local reads only and never enables a provider or refresh job.
NEWS_PUBLIC_PROVIDERS=

# Billing stays disabled until explicitly configured. No live setup is performed by migrations.
# Supported snapshot/REST API version: 2026-10-28.endive.
STRIPE_BILLING_MODE=off
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_IDS=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
# Fixed frontend billing page; never supplied by API callers. HTTPS except localhost development.
STRIPE_BILLING_RETURN_URL=
