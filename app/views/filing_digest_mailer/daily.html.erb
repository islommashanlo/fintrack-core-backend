<h1>SEC filing digest for <%= @batch.local_date %></h1>
<ul><% @deliveries.each do |delivery| %>
  <% cluster = delivery.insider_cluster_snapshot %>
  <li><% if cluster %><%= ClusterAlertText.render(cluster) %><% else %><%= delivery.insider_transaction ? TransactionAlertText.render(delivery.insider_transaction) : "#{delivery.filing.form_type} reported for #{delivery.alert_rule.follow.target_key}" %><% end %>:
    <%= link_to delivery.filing.accession_no, delivery.filing.sec_url %>
    <% if cluster %><ul><% cluster.filing_ids.first(20).each do |id| %><li><%= link_to @cluster_sources.fetch(id).accession_no, @cluster_sources.fetch(id).sec_url %></li><% end %></ul>
    <% if cluster.filing_ids.length > 20 %><p>Additional cluster source filings are available in your alert history.</p><% end %><% end %>
  </li>
<% end %></ul>
<p><%= link_to "Manage email", @unsubscribe_url %></p>
<p><%= FilingsIntel::DISCLAIMER %></p>
