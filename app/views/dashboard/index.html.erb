<% content_for :title, "Dashboard | FilingsIntel" %>

<div class="shell dashboard">
  <section class="hero">
    <div>
      <p class="eyebrow">Public filing signals</p>
      <h1>See where insiders are putting money.</h1>
      <p class="hero__copy">
        A focused view of recent Form 4 purchases, coordinated buying, and the insiders
        filing the strongest purchase activity.
      </p>
    </div>
    <div class="as-of-card">
      <span class="as-of-card__label">Data viewed as of</span>
      <strong><%= @as_of.strftime("%b %-d, %Y") %></strong>
      <span class="as-of-card__note">Windows use SEC filing time.</span>
    </div>
  </section>

  <section class="deadline-banner" aria-label="Next 13F filing deadline">
    <div>
      <p class="eyebrow">Next 13F deadline</p>
      <strong><%= @next_13f_deadline.due_date.strftime("%A, %B %-d, %Y") %></strong>
      <span>For the period ending <%= signal_date(@next_13f_deadline.period_end) %>. The date rolls forward when the statutory deadline falls on a weekend.</span>
    </div>
    <div class="deadline-banner__count">
      <strong><%= @next_13f_deadline.days_remaining %></strong>
      <span>days remaining</span>
    </div>
  </section>

  <% if Current.user %>
    <section class="section-block">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Your watchlist</p>
          <h2>Recent followed activity</h2>
        </div>
        <%= link_to "Manage watchlist", watchlist_path, class: "section-heading__link" %>
      </div>

      <% if @followed_activity.any? %>
        <div class="table-card table-card--wide">
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th scope="col">Profile</th>
                  <th scope="col">Activity</th>
                  <th scope="col">Filed</th>
                  <th scope="col" class="numeric">Reported detail</th>
                </tr>
              </thead>
              <tbody>
                <% @followed_activity.each do |activity| %>
                  <tr>
                    <td>
                      <strong class="table-primary"><%= link_to activity["label"], watchlist_target_path(activity) %></strong>
                      <span class="table-secondary"><%= activity["target_type"].humanize %></span>
                    </td>
                    <td>
                      <% if activity["activity_source"] == "Form 4" %>
                        <span class="transaction-pill transaction-pill--<%= activity["activity_kind"].downcase %>"><%= transaction_type_label(activity["activity_kind"]) %></span>
                        <span class="table-secondary"><%= issuer_label(activity) %></span>
                      <% else %>
                        <span class="change-pill change-pill--add"><%= activity["activity_kind"] %></span>
                        <span class="table-secondary">Period <%= signal_date(activity["period_of_report"]) %></span>
                      <% end %>
                    </td>
                    <td><%= signal_date(activity["filed_at"]) %></td>
                    <td class="numeric">
                      <% if activity["activity_source"] == "Form 4" %>
                        <%= signal_money(activity["value"]) %>
                        <% if activity["price_suspect"] %><span class="table-secondary">price flagged</span><% end %>
                      <% else %>
                        <%= activity["report_type"].to_s.humanize %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% else %>
        <%= render "shared/empty_state", message: "No followed activity was filed in the last 30 days." %>
      <% end %>
    </section>
  <% end %>

  <section class="section-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Latest parsed 13F quarter</p>
        <h2>Institutional whale flow</h2>
      </div>
      <span class="section-heading__count"><%= @institutional_flow.size %> shown</span>
    </div>

    <% if @institutional_flow.any? %>
      <div class="table-card table-card--wide">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col">Security</th>
                <th scope="col">Flow</th>
                <th scope="col" class="numeric">Institutions</th>
                <th scope="col" class="numeric">Moves</th>
                <th scope="col" class="numeric">Net value delta</th>
              </tr>
            </thead>
            <tbody>
              <% @institutional_flow.each do |flow| %>
                <tr>
                  <td>
                    <strong class="table-primary"><%= flow["name_of_issuer"].presence || "Unknown security" %></strong>
                    <span class="table-secondary"><%= [ flow["cusip"], flow["title_of_class"] ].compact_blank.join(" · ") %></span>
                  </td>
                  <td><span class="change-pill change-pill--<%= institutional_flow_class(flow["net_value_usd_delta"]) %>"><%= institutional_flow_label(flow["net_value_usd_delta"]) %></span></td>
                  <td class="numeric"><%= signal_number(flow["institutions"]) %></td>
                  <td class="numeric"><%= signal_number(flow["moves"]) %></td>
                  <td class="numeric">
                    <%= signed_signal_money(flow["net_value_usd_delta"]) %>
                    <% if flow["suspect"] %><span class="table-secondary">some values flagged</span><% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "Institutional flow will appear after quarter-over-quarter 13F diffs are available." %>
    <% end %>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Last 7 days</p>
        <h2>Recent insider purchases</h2>
      </div>
      <span class="section-heading__count"><%= @recent_purchases.size %> shown</span>
    </div>

    <% if @recent_purchases.any? %>
      <div class="table-card table-card--wide">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col">Issuer</th>
                <th scope="col">Insider</th>
                <th scope="col">Filed</th>
                <th scope="col" class="numeric">Shares</th>
                <th scope="col" class="numeric">Price</th>
                <th scope="col" class="numeric">Reported value</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_purchases.each do |purchase| %>
                <tr>
                  <td>
                    <strong class="table-primary"><%= issuer_label(purchase) %></strong>
                    <span class="table-secondary"><%= purchase["issuer_name"].presence || "Issuer name unavailable" %></span>
                  </td>
                  <td>
                    <strong class="table-primary"><%= insider_label(purchase) %></strong>
                    <span class="table-secondary"><%= signal_role(purchase) %></span>
                  </td>
                  <td><%= signal_date(purchase["filed_at"]) %></td>
                  <td class="numeric"><%= signal_number(purchase["shares"]) %></td>
                  <td class="numeric">
                    <%= signal_price(purchase["price"], suspect: purchase["price_suspect"]) %>
                    <% if purchase["price_suspect"] %>
                      <span class="table-secondary">flagged</span>
                    <% end %>
                  </td>
                  <td class="numeric"><%= signal_money(purchase["value"]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "No purchase filings were found in the last 7 days." %>
    <% end %>
  </section>

  <div class="dashboard-grid">
    <section class="section-block">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Last 30 days</p>
          <h2>Cluster buying</h2>
        </div>
        <span class="section-heading__count"><%= @cluster_buys.size %> shown</span>
      </div>

      <% if @cluster_buys.any? %>
        <div class="table-card">
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th scope="col">Issuer</th>
                  <th scope="col" class="numeric">Insiders</th>
                  <th scope="col" class="numeric">Purchases</th>
                  <th scope="col" class="numeric">Value</th>
                </tr>
              </thead>
              <tbody>
                <% @cluster_buys.each do |cluster| %>
                  <tr>
                    <td>
                      <strong class="table-primary"><%= issuer_label(cluster) %></strong>
                      <span class="table-secondary"><%= cluster["issuer_name"].presence || "Issuer name unavailable" %></span>
                    </td>
                    <td class="numeric"><%= signal_number(cluster["insiders"]) %></td>
                    <td class="numeric"><%= signal_number(cluster["purchases"]) %></td>
                    <td class="numeric"><%= signal_money(cluster["value"]) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% else %>
        <%= render "shared/empty_state", message: "No multi-insider buying clusters were found." %>
      <% end %>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Last 90 days</p>
          <h2>Top active insiders</h2>
        </div>
        <span class="section-heading__count"><%= @top_insiders.size %> shown</span>
      </div>

      <% if @top_insiders.any? %>
        <div class="table-card">
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th scope="col">Insider</th>
                  <th scope="col" class="numeric">Purchases</th>
                  <th scope="col" class="numeric">Issuers</th>
                  <th scope="col" class="numeric">Value</th>
                </tr>
              </thead>
              <tbody>
                <% @top_insiders.each do |insider| %>
                  <tr>
                    <td><strong class="table-primary"><%= insider_label(insider) %></strong></td>
                    <td class="numeric"><%= signal_number(insider["purchases"]) %></td>
                    <td class="numeric"><%= signal_number(insider["issuers"]) %></td>
                    <td class="numeric"><%= signal_money(insider["value"]) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% else %>
        <%= render "shared/empty_state", message: "No insider activity was found in the last 90 days." %>
      <% end %>
    </section>
  </div>

  <footer class="dashboard-footer">
    <p>FilingsIntel presents information as reported in SEC filings. It is a research tool, not investment advice.</p>
    <p>Values with missing or flagged prices are shown without an estimated transaction value.</p>
  </footer>
</div>
