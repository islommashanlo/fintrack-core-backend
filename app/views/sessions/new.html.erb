<% content_for :title, "Sign in | FilingsIntel" %>

<div class="shell auth-page">
  <div class="auth-card">
    <p class="eyebrow">Your filing watchlist</p>
    <h1>Sign in</h1>
    <%= tag.div(flash[:alert], class: "form-errors") if flash[:alert] %>
    <%= tag.div(flash[:notice], class: "form-notice") if flash[:notice] %>

    <%= form_with url: session_path, class: "auth-form" do |form| %>
      <%= form.label :email_address, "Email address" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
      <%= form.label :password, "Password" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
      <%= form.submit "Sign in" %>
    <% end %>

    <p class="auth-card__footer"><%= link_to "Forgot password?", new_password_path %> · <%= link_to "Create an account", signup_path %></p>
  </div>
</div>
