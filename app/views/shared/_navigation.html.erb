<header class="site-header">
  <div class="shell site-header__inner">
    <%= link_to root_path, class: "brand", aria: { label: "FilingsIntel dashboard" } do %>
      <span class="brand__mark">F</span>
      <span>FilingsIntel</span>
    <% end %>
    <nav class="site-header__nav" aria-label="Primary navigation">
      <%= link_to "Dashboard", root_path, class: "site-header__link" %>
      <%= link_to "Discover", discover_path, class: "site-header__link" %>
      <% if Current.user %>
        <%= link_to "Watchlist", watchlist_path, class: "site-header__link" %>
        <%= link_to "Alerts", alerts_path, class: "site-header__link" %>
        <span class="site-header__user"><%= Current.user.email_address %></span>
        <%= button_to "Sign out", session_path, method: :delete, class: "site-header__signout" %>
      <% else %>
        <%= link_to "Sign in", new_session_path, class: "site-header__link" %>
        <%= link_to "Create account", signup_path, class: "site-header__link site-header__link--accent" %>
      <% end %>
    </nav>
  </div>
</header>
